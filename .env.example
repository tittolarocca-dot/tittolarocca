APP_NAME="booklola.ch"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─────────────────────────────────────────────
# STRIPE (Test-Keys von https://dashboard.stripe.com/test/apikeys)
# ─────────────────────────────────────────────
STRIPE_KEY=pk_test_DEINE_PUBLISHABLE_KEY
STRIPE_SECRET=sk_test_DEIN_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_DEIN_WEBHOOK_SECRET

# Plattform-Einstellungen
PLATFORM_COMMISSION_PERCENT=20
PLATFORM_PAYOUT_MINIMUM_CHF=50

# ─────────────────────────────────────────────
# E-MAIL (Lokal: Mailpit in Laragon)
# Für Produktion: Resend oder Postmark verwenden
# ─────────────────────────────────────────────

# Option 1: Mailpit (lokal, Laragon) – kein echtes Versenden, nur Vorschau
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@inserate-plattform.ch"
MAIL_FROM_NAME="${APP_NAME}"

# Option 2: Resend (Produktion) – https://resend.com
# MAIL_MAILER=resend
# RESEND_API_KEY=re_DEIN_API_KEY

# Option 3: Postmark (Produktion) – https://postmarkapp.com
# MAIL_MAILER=postmark
# POSTMARK_API_KEY=DEIN_API_KEY

# ─────────────────────────────────────────────
# DATEISPEICHER (lokal = storage/app, Produktion = Cloudflare R2)
# ─────────────────────────────────────────────
FILESYSTEM_DISK=local

# Cloudflare R2 (Produktion)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Veriff – Identitäts- & Altersprüfung (nur Metadaten/Status werden gespeichert)
# VERIFF_API_KEY=
# VERIFF_SECRET=
# VERIFF_BASE_URL=https://stationapi.veriff.com

# ── Launch-Modus & Credit-System ────────────────────────────────────────────
# true = keine echten Zahlungen, Inserate gratis, Push über Launch-Credits
LAUNCH_MODE=true
LAUNCH_CREDITS_INITIAL=10
PUSH_CREDIT_COST=1
PRIVATE_GALLERY_BONUS=3
LAUNCH_LISTING_DAYS=30

# ── SEO ─────────────────────────────────────────────────────────────────────
# false = gesamte Seite bleibt auf noindex (Bauphase). Am Go-Live auf true.
SEO_INDEXABLE=false
SEO_SITE_NAME="booklola.ch"
